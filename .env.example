# --- Site & SEO (required for Google Search) ---
# Subdomain on Hostinger VPS, no trailing slash — e.g. https://vidmate.yourdomain.com
VITE_SITE_URL="https://vidmate.ai-workflows.cloud"

# From Google Search Console → Settings → Ownership verification (HTML tag method: content value only)
VITE_GOOGLE_SITE_VERIFICATION=""

# --- Google AdSense ---
# Publisher ID from AdSense → Account → Account information (format: ca-pub-XXXXXXXX)
VITE_ADSENSE_CLIENT="ca-pub-XXXXXXXXXXXXXXXX"

# Optional: create ad units in AdSense and paste slot IDs here
VITE_ADSENSE_SLOT_HOME=""
VITE_ADSENSE_SLOT_SIDEBAR=""

# --- Legacy AI Studio (optional) ---
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
