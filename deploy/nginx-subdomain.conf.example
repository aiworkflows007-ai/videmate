# Vidmate — Nginx config for a SUBDOMAIN (e.g. vidmate.yourdomain.com)
#
# 1. Copy to server:
#    sudo cp nginx-subdomain.conf.example /etc/nginx/sites-available/vidmate
# 2. Edit: replace SUBDOMAIN and DOMAIN (and root path if needed)
# 3. Enable:
#    sudo ln -sf /etc/nginx/sites-available/vidmate /etc/nginx/sites-enabled/
#    sudo nginx -t && sudo systemctl reload nginx
# 4. SSL (first time):
#    sudo certbot --nginx -d vidmate.ai-workflows.cloud

server {
    listen 80;
    listen [::]:80;
    server_name vidmate.ai-workflows.cloud;

    root /var/www/vidmate;
    index index.html;

    # ads.txt & robots.txt (required for AdSense / SEO)
    location = /ads.txt {
        default_type text/plain;
    }

    location = /robots.txt {
        default_type text/plain;
    }

    location = /sitemap.xml {
        default_type application/xml;
    }

    # SPA: all routes → index.html (/, /privacy, /terms)
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Cache static assets
    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff2?)$ {
        expires 30d;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # Security headers (basic)
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    access_log /var/log/nginx/vidmate.access.log;
    error_log  /var/log/nginx/vidmate.error.log;
}
